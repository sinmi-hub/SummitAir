# Copy to .env locally or /etc/summitair.env on the VM. Never commit secrets.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_VOICE=marin
# Required for a working human handoff; must be the configured E.164 destination.
HUMAN_TRANSFER_NUMBER=
CALL_STATE_PATH=call-state.sqlite3

GOOGLE_SA_KEY_PATH=
# GOOGLE_SA_KEY_B64=  # Alternative to a mounted JSON key
TICKETS_SHEET_ID=
TICKETS_SHEET_TAB=Leads
SERVICE_CALENDAR_ID=
SERVICE_TIMEZONE=America/New_York

# Optional background research (app/research.py): Haiku reads the live
# transcript, Exa searches, results reach the voice model as context only.
RESEARCH_ENABLED=false
ANTHROPIC_API_KEY=
EXA_API_KEY=
EXA_SEARCH_TYPE=fast
WATCHER_MODEL=claude-haiku-4-5-20251001
RESEARCH_MAX_SEARCHES=4
